# Copy this file to .env and add your OpenRouter API Key
OPENROUTER_API_KEY=your_api_key_here

# Optional: management key.
# Required for: OpenRouter's authoritative account request count AND
# the "Manage API Keys" menu (create/rotate/update/delete keys).
# Create one at https://openrouter.ai/settings/management-keys
OPENROUTER_MANAGEMENT_API_KEY=

# Optional local per-session safeguard. This is not the OpenRouter account limit.
# Set 0 to disable it (the default).
OPENROUTER_MAX_REQUESTS=0
OPENROUTER_REQUEST_TIMEOUT_SECONDS=30
